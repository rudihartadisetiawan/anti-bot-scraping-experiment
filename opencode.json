{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",

  "agent": {
    "manager": {
      "description": "Orkestrator eksperimen — breakdown task, review hasil dan insight, keputusan lanjut/stop",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.2,
      "prompt": "{file:./AGENTS.md}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "task": {
          "*": "allow"
        }
      }
    },

    "backend": {
      "description": "Implementasi scraper Playwright, skema data terpadu, analisis perbandingan lintas sumber",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.15,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    },

    "security": {
      "description": "Evaluasi robots.txt/ToS, batas rate wajar, risiko teknik anti-deteksi",
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-max",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "rg *": "allow"
        },
        "webfetch": "allow"
      }
    }
  },

  "permission": {
    "skill": {
      "*": "allow"
    }
  },

  "formatter": {
    "ruff": {}
  },

  "plugin": [
    "opencode-ponytail",
    "opencode-rate-limit",
    "opencode-handoff"
  ],

  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com"
    }
  },

  "autoupdate": true
}